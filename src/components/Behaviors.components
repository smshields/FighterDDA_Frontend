        {
            "name": "ObjectBounceAnimation",
            "displayName": "Object Bounce",
            "objectDisplayFormat": "",
            "baseClass": "UserComponent",
            "gameObjectType": "Phaser.GameObjects.Image",
            "generateGameObjectField": true,
            "properties": [
                {
                    "name": "mode",
                    "label": "Mode",
                    "tooltip": "Determines the method of bounce animation",
                    "defValue": "position",
                    "customDefinition": false,
                    "type": {
                        "id": "option",
                        "options": [
                            "position",
                            "scale",
                            "both"
                        ]
                    }
                },
                {
                    "name": "active",
                    "label": "Active",
                    "tooltip": "Determines if the bounce animation is active.",
