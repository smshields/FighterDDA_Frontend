    "components": [
        {
            "name": "ObjectBounceAnimation",
            "displayName": "Object Bounce",
            "objectDisplayFormat": "",
            "baseClass": "UserComponent",
            "gameObjectType": "Phaser.GameObjects.Image",
            "generateGameObjectField": true,
            "properties": [
                {
                    "name": "mode",
                    "label": "Mode",
                    "tooltip": "Determines the method of bounce animation",
                    "defValue": "position",
                    "customDefinition": false,
                    "type": {
                        "id": "option",
                        "options": [
                            "position",
                            "scale",
                            "both"
                        ]
                    }
                },
                {
                    "name": "active",
                    "label": "Active",
                    "tooltip": "Determines if the bounce animation is active.",
                    "defValue": true,
                    "customDefinition": false,
                    "type": {
                        "id": "boolean"
                    }
                },
                {
                    "name": "posOffset",
                    "label": "Offset Position",
                    "tooltip": "Determines the number of pixels that a bounce will offset.",
                    "defValue": 5,
                    "customDefinition": false,
                    "type": {
                        "id": "number"
                    }
                },
                {
                    "name": "posDuration",
                    "label": "Duration Position",
                    "tooltip": "Determines how long the position animation takes to cycle.",
                    "defValue": 500,
                    "customDefinition": false,
                    "type": {
                        "id": "number"
                    }
                },
                {
                    "name": "scaleXDelta",
                    "label": "X-Axis Scaling",
                    "tooltip": "Determines how much to scale the animation in the x-dimension.",
                    "defValue": 0,
                    "customDefinition": false,
                    "type": {
                        "id": "number"
                    }
                },
                {
                    "name": "scaleYDelta",
                    "label": "Y-Axis Scaling",
                    "tooltip": "Determines how much to scale the animation in the y-dimension.",
                    "defValue": 0.05,
                    "customDefinition": false,
                    "type": {
                        "id": "number"
                    }
                },
                {
                    "name": "scaleDuration",
                    "label": "Duration Scaling",
                    "tooltip": "Determines how long the scaling animation takes to cycle.",
                    "defValue": 500,
                    "customDefinition": false,
                    "type": {
                        "id": "number"
                    }
                },
                {
                    "name": "posEase",
                    "label": "Tweening Ease Function Position",
                    "tooltip": "Determines the function used for position tweening easing.",
                    "defValue": "Sine.easeIn",
                    "customDefinition": false,
                    "type": {
                        "id": "option",
                        "options": [
                            "Linear",
                            "Sine.easeIn",
