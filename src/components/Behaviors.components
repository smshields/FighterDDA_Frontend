                            "Quart.easeInOut",
                            "Quint.easeIn",
                            "Quint.easeOut",
                            "Quint.easeInOut",
                            "Expo.easeIn",
                            "Expo.easeOut",
                            "Expo.easeInOut",
                            "Circ.easeIn",
                            "Circ.easeOut",
                            "Circ.easeInOut",
                            "Back.easeIn",
                            "Back.easeOut",
                            "Back.easeInOut",
                            "Bounce.easeIn",
                            "Bounce.easeOut",
                            "Bounce.easeInOut",
                            "Elastic.easeIn",
                            "Elastic.easeOut",
                            "Elastic.easeInOut"
                        ]
                    }
                },
