                            "Quint.easeInOut",
                            "Expo.easeIn",
                            "Expo.easeOut",
                            "Expo.easeInOut",
                            "Circ.easeIn",
                            "Circ.easeOut",
                            "Circ.easeInOut",
                            "Back.easeIn",
                            "Back.easeOut",
                            "Back.easeInOut",
                            "Bounce.easeIn",
                            "Bounce.easeOut",
                            "Bounce.easeInOut",
                            "Elastic.easeIn",
                            "Elastic.easeOut",
                            "Elastic.easeInOut"
                        ]
                    }
                },
                {
                    "name": "scaleEase",
                    "label": "Tweening Ease Function Scaling",
                    "tooltip": "Determines the function used for scaling tweening easing.",
                    "defValue": "Sine.easeIn",
                    "customDefinition": false,
                    "type": {
                        "id": "option",
                        "options": [
                            "Linear",
                            "Sine.easeIn",
                            "Sine.easeOut",
                            "Sine.easeInOut",
                            "Quad.easeIn",
